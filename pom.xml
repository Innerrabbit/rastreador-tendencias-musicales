<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.x administra las versiones de las dependencias de Spring. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.sena</groupId>
    <artifactId>rastreador-tendencias-musicales</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>
    <name>Rastreador de Tendencias Musicales</name>
    <description>Módulos de catálogo, listas de reproducción y tendencias, expuestos como API REST.</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- API REST: controladores, Tomcat embebido y JSON (Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Autenticación y autorización por roles (RNF-04) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Driver JDBC de MySQL: se conserva la versión probada en la EV01 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!-- Pruebas: JUnit 5, Mockito y MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Genera el ejecutable: mvn clean package  ->  java -jar target/...jar
                 Se indica la clase principal porque el proyecto tiene dos:
                 la web (AplicacionWeb) y el menú de consola de la EV01 (Aplicacion). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>co.edu.sena.rastreador.AplicacionWeb</mainClass>
                </configuration>
            </plugin>

            <!-- Se conserva: mvn compile exec:java  ->  menú de consola de la EV01 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>co.edu.sena.rastreador.Aplicacion</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
